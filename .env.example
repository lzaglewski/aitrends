# Database
DATABASE_URL=sqlite:///./data/trends.db

# Scraping settings
SCRAPE_INTERVAL_HOURS=6
MAX_ARTICLES_PER_SOURCE=50
MIN_ARTICLE_LENGTH=200

# Analysis settings
TREND_WINDOW_DAYS=30
TOP_KEYWORDS_COUNT=20

# Rate limiting
REQUEST_DELAY_SECONDS=2
REQUEST_TIMEOUT=30

# User agent
USER_AGENT=Ad-Trends-Monitor/1.0 (Educational purpose)
